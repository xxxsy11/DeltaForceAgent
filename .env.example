# =========================================================
# Secrets only.
# Non-sensitive runtime options live in config.py and can be optionally overridden by env.
# =========================================================

# LLM
MOONSHOT_API_KEY=your_moonshot_api_key_here

# LangSmith (optional, for LangGraph tracing/monitoring)
# LANGSMITH_ENABLED=1
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=delta-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_TRACING_V2=1
# LANGSMITH_RUN_PREFIX=delta-agent
# LANGSMITH_GRAPH_NAME=delta-agent-graph
# LANGSMITH_TAGS=delta-agent,langgraph

# Self-improving LLM Judge (optional overrides)
# SELF_IMPROVE_LLM_JUDGE_ENABLED=1
# SELF_IMPROVE_LLM_JUDGE_MODEL=kimi-k2-0711-preview
# SELF_IMPROVE_REWARD_RULE_WEIGHT=1.0
# SELF_IMPROVE_REWARD_LLM_WEIGHT=0.8

# Neo4j
NEO4J_PASSWORD=your_neo4j_password_here
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j

# Milvus (optional override)
# MILVUS_HOST=127.0.0.1
# MILVUS_PORT=19530

# Long-term memory (PostgreSQL + pgvector)
MEMORY_PERSISTENT_DSN=postgresql://username:password@127.0.0.1:5432/delta_agent
# MEMORY_PERSISTENT_ENABLED=1

# Delta Force market API
DF_API_TOKEN=your_df_api_token_here
# DF_API_BASE_URL=https://df-api.shallow.ink

# Answer quality (optional override)
# ANSWER_MIN_CHARS=12
