# =========================================================
# Secrets only.
# Non-sensitive runtime options are configured in config.py
# =========================================================

# LLM
MOONSHOT_API_KEY=your_moonshot_api_key_here

# Neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Long-term memory (PostgreSQL + pgvector)
MEMORY_PERSISTENT_DSN=postgresql://username:password@127.0.0.1:5432/deltaforce_agent

# Market data backend (private extension module)
# Example:
# DF_MARKET_BACKEND_MODULE=private_ext.market_backend
# DF_MARKET_BACKEND_CLASS=MarketDataBackendImpl
DF_MARKET_BACKEND_MODULE=
DF_MARKET_BACKEND_CLASS=MarketDataBackendImpl
